<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{$name}</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <main>
        <h1>{$name}</h1>
        <p>Version {$version}</p>
        <p n:if="$owner_npub !== null">Owner: {$owner_npub}</p>
    </main>
</body>
</html>
